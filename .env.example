# The wrapper reads process environment variables; it does not auto-load this file.
# Export these values in your shell or load them with your environment/process manager.

# Robinhood MCP endpoint and OAuth client metadata
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_MCP_CLIENT_NAME="Robinhood MCP Wrapper"
ROBINHOOD_MCP_SCOPE=internal
ROBINHOOD_MCP_REDIRECT_URI=http://127.0.0.1:8765/oauth/callback

# Optional override for the passwordless local OAuth credential file.
# ROBINHOOD_CREDENTIALS_FILE=/absolute/path/to/robinhood-credentials.json

# REST gateway
ROBINHOOD_API_HOST=127.0.0.1
ROBINHOOD_API_PORT=8765
# Required when ROBINHOOD_API_HOST is not loopback.
# ROBINHOOD_API_KEY=replace-with-a-long-random-value

# Timeouts and logging
# Timeouts must be finite positive numbers, in seconds.
ROBINHOOD_CONNECT_TIMEOUT=30
ROBINHOOD_READ_TIMEOUT=300
ROBINHOOD_OAUTH_TIMEOUT=600
# Supported levels: CRITICAL, ERROR, WARNING, INFO, DEBUG, TRACE.
ROBINHOOD_LOG_LEVEL=INFO
